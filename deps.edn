{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        io.github.kotoba-lang/security
        {:git/url "https://github.com/kotoba-lang/security.git"
         :git/sha "23d2e0b6b521318adb43230a5a5c21c76adb738c"}
        ;; Fleet is T6 placement. Execution remains owned by the T3 tender;
        ;; this one-way dependency is the boundary that avoids a cycle.
        io.github.kotoba-lang/kototama
        {:git/url "https://github.com/kotoba-lang/kototama.git"
         :git/sha "15333cc00324c625416d5f3103aed44d1b15ce77"}}
 :aliases
 {:cli {:main-opts ["-m" "fleet.cli"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/url "https://github.com/cognitect-labs/test-runner.git"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}

